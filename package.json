{
  "name": "epubmaker",
  "version": "0.4.0",
  "private": true,
  "description": "EPUB 电子书维护与生成工具（本地桌面应用，Go + Wails）",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "dev:app": "powershell -NoProfile -ExecutionPolicy Bypass -File run.ps1 dev",
    "build:app": "powershell -NoProfile -ExecutionPolicy Bypass -File run.ps1 build",
    "build:app:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File run.ps1 nsis",
    "format": "prettier --write web",
    "format:check": "prettier --check web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "prettier": "3.9.10"
  }
}
