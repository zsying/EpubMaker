<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar glyph for a listening session: a page, then a rising bar
     equaliser for the voice coming off it. Monochrome and solid on purpose —
     Android tints a small icon with one colour and keeps only its alpha, so
     outlines and hairlines disappear and only silhouettes survive.
     Geometry is kept to plain rectangles: no arcs to get wrong in a file that
     only ever gets looked at through a 24dp hole. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,4h7v16h-7z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.5h1.8v3h-1.8z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.2,8h1.8v8h-1.8z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.4,5.5h1.8v13h-1.8z" />
</vector>
