{
  "name": "EpubMaker",
  "outputfilename": "EpubMaker.exe",
  "frontend:dir": "../web",
  "frontend:install": "npm install",
  "frontend:build": "npm run build && node ../scripts/sync-frontend-dist.js",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": "../web/src",
  "author": {
    "name": "john"
  },
  "description": "EpubMaker desktop app (Go + Wails)",
  "tags": "desktop,epub",
  "info": {
    "companyName": "EpubMaker",
    "productName": "EpubMaker",
    "productVersion": "0.1.0",
    "copyright": "Copyright © 2026 john",
    "comments": "EPUB 电子书维护与生成工具（本地桌面应用）",
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB 电子书",
        "description": "EPUB 电子书文件",
        "iconName": "epubFileIcon",
        "role": "Editor"
      }
    ]
  }
}
